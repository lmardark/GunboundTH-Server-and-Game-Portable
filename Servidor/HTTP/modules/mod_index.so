<?php
ini_set('memory_limit', '-1');
ini_set('max_execution_time', '600');
set_time_limit(600);

function GerarCliente($arquivoBase, $arquivoSaida, $arquivoIp, $arquivoLauncherLinux) {
    if (!class_exists('ZipArchive')) {
        throw new RuntimeException('A extensao PHP ZipArchive nao esta instalada.');
    }
    if (!is_file($arquivoBase) || !is_readable($arquivoBase)) {
        throw new RuntimeException('O pacote-base do cliente nao foi encontrado.');
    }
    if (!is_file($arquivoLauncherLinux) || !is_readable($arquivoLauncherLinux)) {
        throw new RuntimeException('O inicializador para Linux nao foi encontrado.');
    }

    $arquivoTemporario = $arquivoSaida . '.tmp.' . getmypid();
    if (!copy($arquivoBase, $arquivoTemporario)) {
        throw new RuntimeException('Nao foi possivel copiar o pacote-base do cliente.');
    }

    $zip = new ZipArchive();
    try {
        $resultado = $zip->open($arquivoTemporario);
        if ($resultado !== true) {
            throw new RuntimeException('Nao foi possivel abrir o pacote-base (erro ' . $resultado . ').');
        }
        if ($zip->locateName('Arquivos/GunBound.exe', ZipArchive::FL_NOCASE) === false) {
            throw new RuntimeException('O pacote-base nao contem Arquivos/GunBound.exe.');
        }

        $ip = trim((string) @file_get_contents($arquivoIp));
        if ($ip === '' || filter_var($ip, FILTER_VALIDATE_IP) === false) {
            throw new RuntimeException('O IP do servidor e invalido ou nao foi configurado.');
        }
        if (!$zip->addFromString('Arquivos/IP.txt', $ip)) {
            throw new RuntimeException('Nao foi possivel configurar o IP no cliente.');
        }
        if (!$zip->addFile($arquivoLauncherLinux, 'JogarLinux.sh')) {
            throw new RuntimeException('Nao foi possivel adicionar o inicializador para Linux.');
        }
        if (method_exists($zip, 'setExternalAttributesName')) {
            $zip->setExternalAttributesName('JogarLinux.sh', ZipArchive::OPSYS_UNIX, 0755 << 16);
        }
        if (!$zip->close()) {
            throw new RuntimeException('Nao foi possivel finalizar o arquivo ZIP.');
        }

        // No Windows, rename() nao substitui um arquivo que ja existe.
        @unlink($arquivoSaida);
        if (!rename($arquivoTemporario, $arquivoSaida)) {
            throw new RuntimeException('Nao foi possivel publicar o arquivo ZIP.');
        }
    } catch (Exception $erro) {
        if ($zip->status === ZipArchive::ER_OK) {
            $zip->close();
        }
        @unlink($arquivoTemporario);
        throw $erro;
    }
}

if (isset($_GET['baixar'])) {
    try {
        GerarCliente(
            __DIR__ . '/ZIP_GunboundCliente.zip',
            __DIR__ . '/GunboundCliente.zip',
            __DIR__ . '/IP.txt',
            __DIR__ . '/JogarLinux.sh'
        );
        echo 'Pronto! O jogo foi gerado com sucesso, <a href="GunboundCliente.zip"><b>CLIQUE AQUI</b></a> para baixar o Gunbound.';
    } catch (Exception $erro) {
        http_response_code(500);
        echo 'Erro ao gerar o jogo: ' . htmlspecialchars($erro->getMessage(), ENT_QUOTES, 'UTF-8');
    }
    exit();
}


echo'
<!DOCTYPE html>
<html lang="pt">
<head>
<title>Gunbound Thor Hammer</title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
